from pathlib import Path
from urllib.parse import quote
import json

BASE_URL = (
    "https://raw.githubusercontent.com/"
    "Mika0924/Aoi-kun-s-Explicit-Dialogue-Collection/main"
)

# Настройки глав: первая и последняя страница в имени файла.
# Если файлы главы называются 01.jpg, 02.jpg ... укажите start=1.
CHAPTERS = {
    1: {"start": 8, "end": 39, "title": "Первая глава"},
    2: {"start": 40, "end": 71, "title": "Вторая глава"},
    9: {"start": 1, "end": 31, "title": "Девятая глава"},
    10: {"start": 1, "end": 31, "title": "Десятая глава"},
}

MANIFEST = {
    "title": "Я не могу насытиться развратными разговорами Аой-куна",
    "artist": "Mika0924",
    "author": "Mika0924",
    "description": "Сборник глав перевода.",
    "cover": f"{BASE_URL}/cover.jpg",
    "chapters": {},
}

for chapter_number, settings in CHAPTERS.items():
    # Сохраняем русское название папки и кодируем пробелы/кириллицу для URL.
    folder = quote(f"{chapter_number} глава", safe="")
    images = [
        f"{BASE_URL}/{folder}/{page:02d}.jpg"
        for page in range(settings["start"], settings["end"] + 1)
    ]
    MANIFEST["chapters"][str(chapter_number)] = {
        "title": settings["title"],
        "volume": "1",
        "groups": {"Перевод": images},
    }

output = Path(__file__).with_name("manifest.json")
output.write_text(
    json.dumps(MANIFEST, ensure_ascii=False, indent=2) + "\n",
    encoding="utf-8",
)
print(f"Готово: {output}")
print(f"Глав создано: {len(MANIFEST['chapters'])}")
print(f"Всего страниц: {sum(len(c['groups']['Перевод']) for c in MANIFEST['chapters'].values())}")
