const fs = require("fs");
const path = require("path");

const ROOT = __dirname;
const OUTPUT = path.join(ROOT, "index.json");

const IMAGE_EXTENSIONS = [".jpg", ".jpeg", ".png", ".webp"];

function naturalSort(a, b) {
  return a.localeCompare(b, undefined, {
    numeric: true,
    sensitivity: "base",
  });
}

function getImageFiles(folderPath) {
  return fs
    .readdirSync(folderPath, { withFileTypes: true })
    .filter(
      (item) =>
        item.isFile() &&
        IMAGE_EXTENSIONS.includes(path.extname(item.name).toLowerCase())
    )
    .map((item) => item.name)
    .sort(naturalSort);
}

function getChapterFolders() {
  return fs
    .readdirSync(ROOT, { withFileTypes: true })
    .filter((item) => {
      if (!item.isDirectory()) return false;
      if (item.name.startsWith(".")) return false;
      if (item.name === "node_modules") return false;

      return /^\d+/.test(item.name);
    })
    .sort((a, b) => naturalSort(a.name, b.name));
}

function encodePathPart(value) {
  return encodeURIComponent(value).replace(/%2F/g, "/");
}

const repoUrl =
  process.env.REPO_URL ||
  "https://raw.githubusercontent.com/Mika0924/Aoi-kun-s-Explicit-Dialogue-Collection/main";

const chapters = {};

for (const folder of getChapterFolders()) {
  const folderPath = path.join(ROOT, folder.name);
  const images = getImageFiles(folderPath);

  if (images.length === 0) {
    console.log(`Пропущена папка без изображений: ${folder.name}`);
    continue;
  }

  const chapterNumber = folder.name.match(/^\d+/)[0];

  chapters[chapterNumber] = {
    title: folder.name,
    volume: "1",
    groups: {
      Перевод: images.map(
        (image) =>
          `${repoUrl}/${encodePathPart(folder.name)}/${encodePathPart(image)}`
      ),
    },
  };

  console.log(
    `Глава ${chapterNumber}: найдено ${images.length} изображений`
  );
}

const index = {
  title: "Я не могу насытиться развратными разговорами Аой-куна",
  artist: "Mika0924",
  author: "Mika0924",
  description: "Сборник глав перевода.",
  cover: `${repoUrl}/cover.jpg`,
  chapters,
};

fs.writeFileSync(OUTPUT, JSON.stringify(index, null, 2) + "\n", "utf8");

console.log(`\nindex.json обновлён.`);
console.log(`Глав найдено: ${Object.keys(chapters).length}`);
